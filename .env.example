# Optional. Copy to .env for local overrides. Internal secrets are generated by Compose.

WEB_PORT=3000
WEB_BIND=127.0.0.1
DB_NAME=mss
DB_TUNING=small
DB_HOST=db
DB_PORT=5432

ENRICHMENT_MODE=auto
ENRICHMENT_ENABLED=true
SEED_SAMPLE=true

# External provider keys (worker only). Leave unset for labelled mock mode.
# JEV_API_KEY=
# JEV_MODEL=jev-latest
# JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
# JEV_PRICE_IN_PER_MTOK=
# JEV_PRICE_OUT_PER_MTOK=

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_PRICE_IN_PER_MTOK=0.15
# OPENAI_PRICE_OUT_PER_MTOK=0.6

BUDGET_CURRENCY=USD
BUDGET_JEV_DAILY=5
BUDGET_OPENAI_DAILY=10
# Additive translate cap (ADR-0029); total OpenAI spend up to 13
BUDGET_TRANSLATE_DAILY=3

INPUT_TOKEN_CAP=4000
WORKER_CONCURRENCY_JEV=2
WORKER_CONCURRENCY_OPENAI=2
WORKER_CONCURRENCY_TRANSLATE=2
RPM_JEV=60
RPM_OPENAI=60
RPM_TRANSLATE=60
MAX_ATTEMPTS=4
CALL_TIMEOUT_MS=30000
CLAIM_VISIBILITY_SECONDS=180
PROMPT_VERSION=v1
MOCK_LATENCY_MS=50
LOG_LEVEL=info

# Article translation (kill switch is system_flags.translation_enabled after migrate)
TRANSLATION_ENABLED=true
# TRANSLATE_MODEL=  # falls back to OPENAI_MODEL
TRANSLATE_CHUNK_TOKENS=1500
TRANSLATE_MAX_CHUNKS=20
TRANSLATE_RATIO_CJK=0.15,Infinity
TRANSLATE_RATIO_OTHER=0.3,3.0
TRANSLATE_CACHE_DAYS=7
TRANSLATE_SUPERSEDED_DAYS=30
TRANSLATE_PROMPT_VERSION=t1

# JSON upload (PoC: open when enabled; ADR-0037)
UPLOAD_ENABLED=true
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_ITEMS=1000
INGEST_STATEMENT_TIMEOUT_MS=10000
UPLOAD_DEADLINE_MS=60000
# INGEST_DB_PASSWORD=  # local only; prefer INGEST_DB_PASSWORD_FILE in Compose
