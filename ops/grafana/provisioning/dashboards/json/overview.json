{
  "title": "Media Signal Overview",
  "panels": [
    {
      "type": "stat",
      "title": "Build info",
      "targets": [{ "expr": "mss_build_info" }],
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 }
    },
    {
      "type": "graph",
      "title": "Worker heartbeat",
      "targets": [{ "expr": "mss_worker_heartbeat_unixtime" }],
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 }
    },
    {
      "type": "row",
      "title": "Uploads",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 }
    },
    {
      "type": "graph",
      "title": "Upload request rate by outcome",
      "targets": [{ "expr": "sum by (outcome) (rate(mss_upload_requests_total[5m]))" }],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 9 }
    },
    {
      "type": "graph",
      "title": "Upload rejections by reason",
      "targets": [{ "expr": "sum by (reason) (rate(mss_upload_rejected_total[5m]))" }],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 9 }
    },
    {
      "type": "graph",
      "title": "Upload duration p50/p95",
      "targets": [
        { "expr": "histogram_quantile(0.5, sum(rate(mss_upload_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(mss_upload_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 }
    },
    {
      "type": "stat",
      "title": "Upload in flight",
      "targets": [{ "expr": "mss_upload_in_flight" }],
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 17 }
    },
    {
      "type": "stat",
      "title": "Reconcile mismatches (must be 0)",
      "targets": [{ "expr": "mss_upload_reconcile_mismatch_total" }],
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 17 }
    },
    {
      "type": "row",
      "title": "Translation",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 21 }
    },
    {
      "type": "graph",
      "title": "Translation jobs queued",
      "targets": [{ "expr": "mss_jobs_queued{part=\"translation\"}" }],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 22 }
    },
    {
      "type": "graph",
      "title": "Translation dead / lag",
      "targets": [
        { "expr": "rate(mss_translation_dead_total[5m])", "legendFormat": "dead/s" },
        { "expr": "histogram_quantile(0.95, sum(rate(mss_translation_lag_seconds_bucket[5m])) by (le))", "legendFormat": "lag p95" }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 22 }
    },
    {
      "type": "stat",
      "title": "Foreign untranslated",
      "targets": [{ "expr": "mss_search_foreign_untranslated" }],
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 22 }
    },
    {
      "type": "row",
      "title": "Search",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 }
    },
    {
      "type": "graph",
      "title": "Search latency p95 by kind",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(mss_search_duration_seconds_bucket[5m])) by (le, kind))", "legendFormat": "{{kind}}" }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 31 }
    },
    {
      "type": "stat",
      "title": "Search index valid",
      "targets": [{ "expr": "min(mss_search_index_valid)" }],
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 31 }
    },
    {
      "type": "stat",
      "title": "Articles missing summary",
      "targets": [{ "expr": "mss_search_summary_missing" }],
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 31 }
    }
  ],
  "schemaVersion": 39,
  "version": 3
}
